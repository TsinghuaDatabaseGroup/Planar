OPENAI_API_KEY=replace-with-your-api-key
LLM_API_BASE=https://llm-endpoint.example/v1
EMBEDDING_API_BASE=https://embedding-endpoint.example/v1
LLM_MODEL_NAME=Qwen3.5-397B-A17B

# Claude Code launchers. The text model is fixed to Qwen3.5-397B-A17B.
CLAUDE_COMMAND=claude
CLAUDE_PIPELINE_PYTHON=python
LOTUS_PIPELINE_PYTHON=python
MODEL_MAX_CONCURRENCY=10

# Shared model limits and pricing.
LLM_MODEL_MAX_INPUT_TOKENS=128000
LLM_MODEL_MAX_OUTPUT_TOKENS=32768
LLM_MODEL_USD_PER_INPUT_TOKEN=0.00000039
LLM_MODEL_USD_PER_OUTPUT_TOKEN=0.00000234

# Embedding model metadata.
EMBEDDING_MODEL_NAME=Qwen3-Embedding-8B
EMBEDDING_MODEL_MAX_INPUT_TOKENS=32768
EMBEDDING_MODEL_USD_PER_INPUT_TOKEN=0.00000001
