  "input_plan": {
    "task_id": "vehicle_safety-039",
    "query": "Across Ford complaints and recalls, which five distinct recall campaigns rank highest by corroborating complaint count, where corroboration means that the complaint is in the same component category and describes the same underlying defect as the recall summary? For each campaign, what are its rank, campaign number, component ID, distinct corroborating complaint count, and whether an NHTSA investigation report cites the recall number? Campaign number ascending breaks ties in corroborating complaint count.",
    "inputs": [
      {
        "source_id": "complaints_csv",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "table",
        "role": "primary"
      },
      {
        "source_id": "recalls_jsonl",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "document",
        "role": "primary"
      },
      {
        "source_id": "investigation_reports_txt",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SCAN_DOCS(NHTSA, investigation_reports, selector='*.txt', columns=[file_id, body]) -> SEM_EXTRACT('Extract every NHTSA recall number cited in the body; normalize to the NHTSA canonical core (2-digit year + 3-digit campaign sequence) and deduplicate.', out_schema={cited_recall_cores: list[string]}, input_bindings={text: body}) -> GROUP_BY([], aggs={investigation_cited_cores: collect_distinct(cited_recall_cores)}) -> JOIN(cross, right=( SCAN_DOCS(NHTSA, recalls, [campaign.number, vehicle.make, component.component_id AS component_id, risk.defect_summary AS defect_summary]) -> FILTER(vehicle.make='FORD') -> DEDUP([campaign.number]) -> SEM_JOIN('Within the same component_id block, match a Ford recall campaign to a Ford complaint only when the complaint narrative describes the same underlying defect as the recall defect summary.', input_bindings_left={component_id: component_id, defect_summary: defect_summary}, input_bindings_right={component_id: c.component_id, complaint_summary: c.summary_text}, right=( SCAN_TABLE(NHTSA, complaints AS c, [complaint_id, make, component_id, summary_text]) -> FILTER(make='FORD') )) -> GROUP_BY([campaign.number], aggs={component_id: any(component_id), corroborating_complaint_count: count_distinct(complaint_id)}) )) -> PROJECT([campaign_number: campaign.number, component_id, corroborating_complaint_count, cited_by_investigation: (core(campaign.number) IN investigation_cited_cores ? 'true' : 'false')]) -> ORDER_BY([corroborating_complaint_count DESC, campaign_number ASC]) -> LIMIT(5) -> PROJECT([rank: row_number(), campaign_number, component_id, corroborating_complaint_count, cited_by_investigation])"
      }
    ],
    "answer_schema": {
      "type": "ordered_list",
      "columns": [
        "rank",
        "campaign_number",
        "component_id",
        "corroborating_complaint_count",
        "cited_by_investigation"
      ],
      "types": [
        "integer",
        "string",
        "string",
        "integer",
        "string"
      ]
    }
  },
