  "input_plan": {
    "task_id": "vehicle_safety-033",
    "query": "Which complaint-recall pairs involve the same vehicle make, model, model year, and component category, have a recall reported at least 1,500 days after the complaint, and describe the same defect mechanism in the complaint and recall summaries? For each long-lag pair, I want to know the complaint ID, recall campaign number, elapsed days, and a short root-cause phrase from the recall defect summary.",
    "inputs": [
      {
        "source_id": "complaints_csv",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "table",
        "role": "primary"
      },
      {
        "source_id": "recalls_jsonl",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SCAN_DOCS(NHTSA, recalls, [campaign.number, vehicle.vehicle_id AS vehicle_id, component.component_id AS component_id, campaign.report_received_date, risk.defect_summary]) -> FILTER(campaign.report_received_date IS NOT NULL AND campaign.report_received_date <> '') -> SEM_EXTRACT('Extract a short (<=10 words) root-cause phrase from risk.defect_summary.', out_schema={defect_root_cause: string}, input_bindings={text: risk.defect_summary}) -> JOIN(inner, on=[vehicle_id, component_id, complaint.received_date < right.report_received_date AND date_diff(right.report_received_date, complaint.received_date) >= 1500], right=( SCAN_TABLE(NHTSA, complaints, [complaint_id, vehicle_id, component_id, received_date, summary_text]) )) -> SEM_FILTER('the complaint summary describes the same defect mechanism as the recall defect summary', input_bindings={complaint_text: summary_text, recall_text: risk.defect_summary}) -> PROJECT([complaint_id, campaign.number AS campaign_number, date_diff(report_received_date, received_date) AS days_between, defect_root_cause])"
      }
    ],
    "answer_schema": {
      "type": "table",
      "columns": [
        "complaint_id",
        "campaign_number",
        "days_between",
        "defect_root_cause"
      ],
      "types": [
        "string",
        "string",
        "integer",
        "string"
      ]
    }
  },
