  "input_plan": {
    "task_id": "legal_contracts-090",
    "query": "For non-disclosure agreements that expressly contain both a standstill provision and an employee non-solicitation clause and state both durations, how are the agreements distributed according to which restriction lasts longer? Report the duration comparison (employee restriction longer, equal, or standstill longer), the number of agreements, and the average number of the six standard confidentiality exceptions present—public information, prior knowledge, independent development, third-party receipt, legal compulsion, and written consent—rounded to two decimal places. Order the categories by agreement count descending.",
    "inputs": [
      {
        "source_id": "CONTRACTEXHIBIT_corpus",
        "dataset": "CONTRACTEXHIBIT",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SCAN_DOCS(CONTRACTEXHIBIT, all) -> SEM_FILTER('document is a non-disclosure agreement, including dual-labeled NDA exhibits') -> SEM_FILTER('agreement expressly contains both a standstill provision and an employee non-solicitation clause') -> SEM_EXTRACT('standstill duration; employee non-solicitation duration; presence of each of the 6 named confidentiality exceptions') -> FILTER(standstill_duration IS NOT NULL AND employee_non_solicitation_duration IS NOT NULL) -> PROJECT(class_label = CASE WHEN employee_duration > standstill_duration THEN 'employee_restriction_longer' WHEN employee_duration = standstill_duration THEN 'equal' ELSE 'standstill_longer' END, exception_count = sum(six_exception_flags)) -> GROUP_BY(class_label, agreement_count = COUNT(*), average_exception_count = ROUND(AVG(exception_count), 2)) -> ORDER_BY(agreement_count DESC, class_label ASC)"
      }
    ],
    "answer_schema": {
      "columns": [
        "class_label",
        "agreement_count",
        "average_exception_count"
      ],
      "types": [
        "string",
        "integer",
        "float"
      ]
    }
  },
