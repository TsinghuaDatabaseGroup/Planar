      {
        "source_id": "data/contract-exhibit",
        "dataset": "CONTRACTEXHIBIT",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SOX = SCAN_DOCS(CONTRACTEXHIBIT, all) -> SEM_FILTER('Is this an EX-31 SOX officer certification?') -> SEM_EXTRACT('Extract the certified company entity and certifying officer name with title', {company: str, certifying_officer: str}) -> GROUP_BY(company, certifying_officers = SORT_ASC(DISTINCT(certifying_officer))); CLAWBACK = SCAN_DOCS(CONTRACTEXHIBIT, all) -> SEM_FILTER('Is this an EX-97 clawback policy?') -> SEM_FILTER('Does the policy provide financial-restatement recovery and also permit recovery for misconduct?') -> SEM_EXTRACT('Extract the company entity and normalize the policy covered-person category', {company: str, covered_person_category: str}) -> DEDUP(company, covered_person_category); SEM_JOIN(SOX, CLAWBACK, on='same company entity despite naming, punctuation, or corporate-suffix variation') -> PROJECT(company, certifying_officers, covered_person_category)"
      }
    ],
    "answer_schema": {
      "type": "table",
      "columns": [
        "company",
        "certifying_officers",
        "covered_person_category"
      ],
      "types": [
        "string",
        "list[string]",
        "string"
      ]
    }
  },
