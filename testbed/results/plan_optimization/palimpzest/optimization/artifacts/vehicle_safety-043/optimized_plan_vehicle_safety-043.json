  "input_plan": {
    "task_id": "vehicle_safety-043",
    "query": "For Ford, Jeep, Honda, and Tesla, how well do complaints, recalls, and NHTSA investigation reports align for each make? I want to know the number of distinct recall campaigns, the number of distinct complaints that match one of the make's recalls in the same component category and describe the same underlying defect, and whether any campaign is cited by an investigation report, labeled as cited or not_cited.",
    "inputs": [
      {
        "source_id": "investigation_reports_txt",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "document",
        "role": "primary"
      },
      {
        "source_id": "recalls_jsonl",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "document",
        "role": "primary"
      },
      {
        "source_id": "complaints_csv",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "table",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SCAN_DOCS(NHTSA, investigation_reports, selector='*.txt', columns=[file_id, body]) -> SEM_EXTRACT('Extract every NHTSA recall number cited in the body; normalize to the NHTSA canonical core (2-digit year + 3-digit campaign sequence) and deduplicate.', out_schema={cited_recall_cores: list[string]}, input_bindings={text: body}) -> GROUP_BY([], aggs={investigation_cited_cores: collect_distinct(cited_recall_cores)}) -> JOIN(cross, right=( SCAN_DOCS(NHTSA, recalls, [campaign.number, vehicle.make AS make]) -> FILTER(vehicle.make IN ['FORD','JEEP','HONDA','TESLA']) -> GROUP_BY([make], aggs={recall_campaign_count: count_distinct(campaign.number), all_recall_cores: collect_distinct(core(campaign.number))}) -> JOIN(left, on=[make = right.make], right=( SCAN_TABLE(NHTSA, complaints, [complaint_id, make, component_id, summary_text]) -> FILTER(make IN ['FORD','JEEP','HONDA','TESLA']) -> SEM_JOIN('Within the same make and component category, match a complaint to a recall only when the complaint narrative describes the same underlying defect as the recall defect summary.', input_bindings_left={make: make, component_id: component_id, complaint_summary: summary_text}, input_bindings_right={make: r.make, component_id: r.component_id, recall_defect_summary: r.defect_summary}, right=( SCAN_DOCS(NHTSA, recalls AS r, [campaign.number, vehicle.make AS make, component.component_id AS component_id, risk.defect_summary AS defect_summary]) -> FILTER(vehicle.make IN ['FORD','JEEP','HONDA','TESLA']) )) -> GROUP_BY([make], aggs={corroborated_complaint_count: count_distinct(complaint_id)}) )) )) -> PROJECT(format_as_dictionary, key=make, value={corroborated_complaint_count: coalesce(corroborated_complaint_count, 0), recall_campaign_count, alignment_label: (intersects(all_recall_cores, investigation_cited_cores) ? 'cited' : 'not_cited')})"
      }
    ],
    "answer_schema": {
      "type": "dictionary",
      "key_description": "vehicle make (string, one of FORD, JEEP, HONDA, TESLA)",
      "value_schema": {
        "corroborated_complaint_count": "integer - distinct complaints of this make whose narrative semantically matches one of the make's recalls in the same component category",
        "recall_campaign_count": "integer - distinct recall campaign numbers for this make",
        "alignment_label": "string in {cited, not_cited}"
      }
    }
  },
