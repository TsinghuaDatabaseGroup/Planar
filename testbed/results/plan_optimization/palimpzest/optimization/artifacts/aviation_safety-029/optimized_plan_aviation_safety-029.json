  "input_plan": {
    "task_id": "aviation_safety-029",
    "query": "For reports from the 1201-1800 local-time period, how are approach or landing incidents distributed by flight condition and recorded result when weather or visibility, rather than traffic spacing, runway occupancy, or equipment, caused a go-around, missed approach, or new clearance? Flight conditions are IMC, Marginal, and Mixed; results are go_around_or_missed_approach and new_clearance. Show one row for every represented combination.",
    "inputs": [
      {
        "source_id": "incidents.csv",
        "dataset": "NASA_ASRS",
        "source_type": "table",
        "role": "primary"
      },
      {
        "source_id": "environment_attributes.csv",
        "dataset": "NASA_ASRS",
        "source_type": "table",
        "role": "primary"
      },
      {
        "source_id": "events.csv",
        "dataset": "NASA_ASRS",
        "source_type": "table",
        "role": "primary"
      },
      {
        "source_id": "text/*",
        "dataset": "NASA_ASRS",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "semantic_candidates := (\n  SCAN_TABLE(NASA_ASRS, incidents.csv, [incident_id, text_file, local_time_of_day, flight_phase])\n  -> FILTER(local_time_of_day = '1201-1800')\n  -> SCAN_DOCS(NASA_ASRS, selector=filtered_incidents.text_file, [incident_id, text])\n  -> SEM_FILTER(\"Keep reports where weather or visibility explicitly caused a go-around, missed approach, or new clearance.\", {text})\n  -> SEM_FILTER(\"Exclude reports where traffic spacing, runway occupancy, or aircraft equipment was the primary cause of that result.\", {text})\n)\nenvironment_records := (\n  SCAN_TABLE(NASA_ASRS, environment_attributes.csv, [incident_id, attribute, value])\n  -> FILTER(attribute = 'flight_conditions' AND value IN ('IMC','Marginal','Mixed'))\n)\ncandidates_with_environment := JOIN(left=semantic_candidates, right=environment_records, join_type=inner, condition=semantic_candidates.incident_id = environment_records.incident_id)\nresult_events := (\n  SCAN_TABLE(NASA_ASRS, events.csv, [incident_id, event_type, label])\n  -> FILTER(event_type = 'result' AND label IN ('Flight Crew Executed Go Around / Missed Approach','Air Traffic Control Issued New Clearance'))\n)\njoined := JOIN(left=candidates_with_environment, right=result_events, join_type=inner, condition=candidates_with_environment.incident_id = result_events.incident_id)\njoined\n-> FILTER(flight_phase CONTAINS 'Approach' OR flight_phase CONTAINS 'Landing')\n-> GROUP_BY([flight_conditions:value, recorded_result=CASE label WHEN 'Flight Crew Executed Go Around / Missed Approach' THEN 'go_around_or_missed_approach' ELSE 'new_clearance' END], {incident_count:COUNT_DISTINCT(incident_id)})"
      }
    ],
    "answer_schema": {
      "type": "table",
      "columns": [
        "flight_conditions",
        "recorded_result",
        "incident_count"
      ],
      "types": [
        "string",
        "string",
        "integer"
      ]
    }
  },
