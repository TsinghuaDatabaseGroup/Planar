    "task_id": "vehicle_safety-046",
    "query": "For Chrysler airbag recall campaigns whose summaries describe the same defect as complaint narratives and whose matched defects are also discussed in investigation reports as the same airbag risk, what matched complaint count, dominant airbag failure mode, dominant remedy style in {software_update, part_replacement, other}, related investigation report IDs, and short ODI evidence summary correspond to each campaign number?",
    "inputs": [
      {
        "source_id": "complaints_csv",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "table",
        "role": "primary"
      },
      {
        "source_id": "recalls_jsonl",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "document",
        "role": "primary"
      },
      {
        "source_id": "investigation_reports_txt",
        "dataset": "NHTSA Vehicle Safety",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SCAN_TABLE(NHTSA, complaints, [complaint_id, make, component_id, summary_text]) -> FILTER(make='CHRYSLER' AND component_id='AIRBAG') -> SEM_JOIN('Within Chrysler AIRBAG records, match a complaint to a recall only when the complaint narrative and recall defect summary describe the same airbag defect.', input_bindings_left={complaint_summary: summary_text, component_id: component_id}, input_bindings_right={recall_defect: r.risk.defect_summary, component_id: r.component_id}, right=( SCAN_DOCS(NHTSA, recalls AS r, [campaign.number, vehicle.make AS make, component.component_id AS component_id, risk.defect_summary, risk.consequence_summary, remedy.corrective_action]) -> FILTER(vehicle.make='CHRYSLER' AND component.component_id='AIRBAG') )) -> SEM_FILTER('the matched evidence describes an airbag safety risk such as non-deployment, unintended deployment, inflator rupture, or occupant injury risk', input_bindings={complaint_text: summary_text, recall_text: r.risk.defect_summary, consequence: r.risk.consequence_summary}) -> SEM_CLASSIFY('Assign the dominant airbag failure mode.', target_labels=['non_deployment','unintended_deployment','inflator_rupture','warning_or_sensor_fault','other'], input_bindings={text: summary_text}) -> SEM_JOIN('Match the Chrysler airbag issue to an investigation report only when the report discusses the same airbag risk or ODI evidence.', input_bindings_left={failure_mode: group, complaint_text: summary_text, recall_text: r.risk.defect_summary}, input_bindings_right={report_body: body}, right=( SCAN_DOCS(NHTSA, investigation_reports, selector='*.txt', columns=[file_id, body]) -> FILTER(body CONTAINS 'Chrysler' OR body CONTAINS 'airbag' OR body CONTAINS 'inflator') )) -> GROUP_BY([r.campaign.number], aggs={matched_complaint_count: count_distinct(complaint_id), dominant_airbag_failure_mode: mode_with_tiebreak(group, tiebreak='alpha_asc'), corrective_actions: collect_distinct(r.remedy.corrective_action), related_report_ids: collect_distinct_sorted(file_id, 'asc'), report_bodies: collect_distinct(body)}) -> SEM_AGGREGATE('Assign dominant_remedy_style from software_update, part_replacement, other and summarize ODI evidence in one short phrase.', out_schema={dominant_remedy_style: string, odi_evidence_summary: string}, group_by=[r.campaign.number], input_bindings={remedies: corrective_actions, reports: report_bodies}) -> PROJECT([campaign_number: r.campaign.number, matched_complaint_count, dominant_airbag_failure_mode, dominant_remedy_style, related_report_ids, odi_evidence_summary])"
      }
    ],
    "answer_schema": {
      "type": "table",
      "columns": [
        "campaign_number",
        "matched_complaint_count",
