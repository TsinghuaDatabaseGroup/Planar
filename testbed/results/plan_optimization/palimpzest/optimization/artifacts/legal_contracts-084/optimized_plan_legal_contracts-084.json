  "input_plan": {
    "task_id": "legal_contracts-084",
    "query": "Which companies have a SOX Section 302 certification, a clawback policy that permits recovery for misconduct, and at least one subsidiary-list filing naming 70 or more subsidiaries? For each company, report its distinct certifying officers, normalized covered-person category, and largest subsidiary count in the corpus. Order by the largest subsidiary count descending; break ties by company name.",
    "inputs": [
      {
        "source_id": "data/contract-exhibit",
        "dataset": "CONTRACTEXHIBIT",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SOX = SCAN_DOCS(CONTRACTEXHIBIT, all) -> SEM_FILTER('Is this a SOX Section 302 certification document?') -> SEM_EXTRACT('Extract the certified company entity and certifying officer with title', {company: str, certifying_officer: str}) -> GROUP_BY(company, certifying_officers = SORT_ASC(DISTINCT(certifying_officer))); CLAWBACK = SCAN_DOCS(CONTRACTEXHIBIT, all) -> SEM_FILTER('Is this a clawback or compensation-recovery policy?') -> SEM_FILTER('Does the policy permit recovery for misconduct?') -> SEM_EXTRACT('Extract the company entity and normalize the covered-person category', {company: str, covered_person_category: str}) -> DEDUP(company, covered_person_category); SUBSIDIARIES = SCAN_DOCS(CONTRACTEXHIBIT, all) -> SEM_FILTER('Is this a subsidiary-list filing?') -> SEM_EXTRACT('Extract the parent company entity and number of listed subsidiaries', {company: str, subsidiary_count: integer}) -> FILTER(subsidiary_count >= 70) -> GROUP_BY(company, largest_subsidiary_count = MAX(subsidiary_count)); SEM_JOIN(SOX, CLAWBACK, on='same company entity despite naming, punctuation, or corporate-suffix variation') -> SEM_JOIN(SUBSIDIARIES, on='same company entity despite naming, punctuation, or corporate-suffix variation') -> ORDER_BY(largest_subsidiary_count DESC, company ASC)"
      }
    ],
    "answer_schema": {
      "type": "table",
      "columns": [
        "company",
        "certifying_officers",
        "covered_person_category",
        "largest_subsidiary_count"
      ],
      "types": [
        "string",
        "list[string]",
        "string",
        "integer"
      ]
    }
  },
