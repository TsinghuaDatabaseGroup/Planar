  "input_plan": {
    "task_id": "legal_contracts-086",
    "query": "Among documents classified as NDAs, including dual-labelled exhibits, with effective dates after 2010-01-01, which stated governing-law jurisdictions occur in agreements that define confidential information to include electronic data or records, email, software or code, metadata, or other computer-readable material; require destruction of at least some confidential materials or copies rather than only their return; and expressly continue confidentiality or non-use duties beyond termination or expiry? Report the matching NDA count by jurisdiction, ordered by count descending and then jurisdiction alphabetically.",
    "inputs": [
      {
        "source_id": "data/contract-exhibit",
        "dataset": "CONTRACTEXHIBIT",
        "source_type": "document",
        "role": "primary"
      }
    ],
    "reference_semantic_plan": [
      {
        "type": "operator_dag",
        "program": "SCAN_DOCS(CONTRACTEXHIBIT, all) -> SEM_FILTER('Is this document classified as an NDA, including a dual-labelled NDA exhibit, with an effective date strictly after 2010-01-01?') -> SEM_FILTER('Does the confidential-information definition explicitly include electronic data or records, email, software or code, metadata, or other computer-readable material?') -> SEM_FILTER('Does the agreement require destruction of at least some confidential materials or copies, excluding clauses that only require return or merely allow an unrestricted choice between return and destruction?') -> SEM_FILTER('Do confidentiality or non-use obligations expressly survive termination or expiry or continue beyond the stated term?') -> SEM_EXTRACT('Extract and canonicalize the expressly stated governing-law jurisdiction; return null when unstated', {governing_law: str|null}) -> FILTER(governing_law IS NOT NULL) -> GROUP_BY(governing_law, matching_count = COUNT(*)) -> ORDER_BY(matching_count DESC, governing_law ASC)"
      }
    ],
    "answer_schema": {
      "type": "table",
      "columns": [
        "governing_law",
        "matching_count"
      ],
      "types": [
        "string",
        "integer"
      ]
    }
  },
